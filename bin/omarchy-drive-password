#!/bin/bash

# omarchy:summary=Set a new encryption password for a drive selected.
# omarchy:requires-sudo=true

encrypted_drives=$(blkid -t TYPE=crypto_LUKS -o device)

if [[ -n $encrypted_drives ]]; then
  if (( $(wc -l <<<"$encrypted_drives") == 1 )); then
    drive_to_change="$encrypted_drives"
  else
    drive_to_change="$(omarchy-drive-select "$encrypted_drives")"
  fi

  if [[ -n $drive_to_change ]]; then
    echo "Changing full-disk encryption password for $drive_to_change"
    echo "You'll be asked for your login password (sudo), then the current drive password, then the new one."
    echo
    sudo -v || exit 1

    # Verify the current password up front, so a typo is caught before a new
    # one is chosen and it's never unclear which password a prompt wants.
    for attempt in 1 2 3; do
      current_password=$(gum input --password --header "Current encryption password (the one you enter at boot)") || exit 1
      echo "Checking current encryption password..."
      if printf "%s" "$current_password" | sudo cryptsetup open --test-passphrase --key-file - "$drive_to_change" 2>/dev/null; then
        current_verified=true
        break
      fi
      echo "That is not the current encryption password for $drive_to_change."
    done
    [[ -n $current_verified ]] || { echo "Encryption password was not changed."; exit 1; }

    new_password=$(gum input --password --header "New encryption password") || exit 1
    [[ -n $new_password ]] || { echo "Password cannot be empty. Encryption password was not changed."; exit 1; }

    confirmation=$(gum input --password --header "Confirm new encryption password") || exit 1
    [[ $new_password == "$confirmation" ]] || { echo "Passwords do not match. Encryption password was not changed."; exit 1; }

    echo "Setting new encryption password..."
    # Both keys travel over stdin and reach cryptsetup as keyfiles, so neither
    # shows up in the process list and cryptsetup never has to prompt.
    if printf "%s\n%s\n" "$current_password" "$new_password" | sudo bash -c '
      IFS= read -r current_password
      IFS= read -r new_password
      exec cryptsetup luksChangeKey --pbkdf argon2id --iter-time 2000 \
        --key-file <(printf "%s" "$current_password") "$1" <(printf "%s" "$new_password")
    ' bash "$drive_to_change"; then
      echo "Encryption password changed. Use the new password the next time you boot."
    else
      echo "Encryption password was not changed. The current password still applies."
      exit 1
    fi
  else
    echo "No drive selected."
  fi
else
  echo "No encrypted drives available."
  exit 1
fi
